{
  "systems": [
    {
      "system": "Clock",
      "reads": "dt/config",
      "writes": "clock/revision/singleton",
      "boundary": "\u5148\u4e8eStatistics"
    },
    {
      "system": "Statistics",
      "reads": "\u65e7Position/MP/Fog/current batch",
      "writes": "observation/history/visibility/counts",
      "boundary": "\u6210\u529f\u540e\u624d\u80fd\u51c6\u5907\u5e76\u884c\u533a"
    },
    {
      "system": "Movement",
      "reads": "Movement/Position/map",
      "writes": "Position\u503c/animation/spatial/dirty/moving",
      "boundary": "\u4e0d\u6539\u53d8Position\u5b58\u5728\u6027\u6216external ID\u8ba1\u6570"
    },
    {
      "system": "Visuals compute",
      "reads": "Position\u5b58\u5728\u6027/next ID/owned maps/raw dt",
      "writes": "owned maps/\u6709\u5e8fSpawn-Remove journal",
      "boundary": "\u4e0eMovement\u8ba1\u7b97\u91cd\u53e0\uff0c\u4e0d\u8bbf\u95eeWorld"
    },
    {
      "system": "Visuals publish",
      "reads": "journal\u6210\u529f\u524d\u7f00",
      "writes": "World\u7ed3\u6784/InitialComponents/unit membership/Visuals",
      "boundary": "join\u540e\uff0cRecovery\u524d\uff0c\u539f\u5e8f\u63d0\u4ea4"
    },
    {
      "system": "Recovery",
      "reads": "clock/components/deadlines/new IDs",
      "writes": "AP/MP/SP/index/dirty",
      "boundary": "\u5728Visuals\u5b8c\u6574\u53d1\u5e03\u540e"
    },
    {
      "system": "Lifecycle",
      "reads": "clock/mode/rules/living",
      "writes": "GameState/GameOver event",
      "boundary": "\u5728Recovery\u540e\u3001Vision\u524d"
    },
    {
      "system": "Vision",
      "reads": "\u65b0Position/Vision/terrain/rules",
      "writes": "cache/Fog/Vision/presentation",
      "boundary": "\u539f\u5e8f\uff0cGameOver\u4ecd\u6267\u884c"
    },
    {
      "system": "Capture",
      "reads": "\u65b0Position/capture/ownership",
      "writes": "capture/ownership/events",
      "boundary": "\u539f\u5e8f\uff1b\u9519\u8bef\u4fdd\u7559\u524d\u5e8f\u63d0\u4ea4"
    }
  ],
